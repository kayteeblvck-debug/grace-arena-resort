# Backend environment. Everything here has a development default in
# src/main/resources/application.yaml — these are the values to set when deploying.
# Source this file, or set the variables however your host expects.

# --- required in every deployed environment -------------------------------
# At least 32 characters. The app logs a warning while the built-in dev value is in use.
APP_JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
# Returns email confirmation links in API responses. Development only.
APP_EXPOSE_VERIFICATION_LINK=false

# --- where things live ----------------------------------------------------
APP_FRONTEND_URL=https://gracearenaresort.com
APP_CORS_ALLOWED_ORIGINS=https://gracearenaresort.com,https://www.gracearenaresort.com

# --- SMTP -----------------------------------------------------------------
# Leave SPRING_MAIL_HOST unset to log emails instead of sending them.
SPRING_MAIL_HOST=smtp.zoho.com
SPRING_MAIL_USERNAME=no-reply@gracearenaresort.com
SPRING_MAIL_PASSWORD=
MAIL_PORT=587
APP_MAIL_FROM=no-reply@gracearenaresort.com
APP_MAIL_FROM_NAME=Grace Arena Resorts
APP_MAIL_RESERVATIONS=reservations@gracearenaresort.com

# --- optional -------------------------------------------------------------
APP_JWT_EXPIRATION_MS=604800000
APP_VERIFICATION_TTL_HOURS=24
APP_SEED_ADMIN_PASSWORD=
